{
  "info": {
    "_postman_id": "84c0d0a6-68f0-47b6-9aa4-57edfba34790",
    "name": "Library Management API",
    "description": "CRUD, authentication, and profile requests for the Library Management API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "jwt_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "genre_id", "value": "" },
    { "key": "book_id", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Library User\",\n  \"email\": \"reader@example.com\",\n  \"password\": \"change-this-password\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) pm.collectionVariables.set('jwt_token', response.access_token);",
                  "if (response.user?.id) pm.collectionVariables.set('user_id', response.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"change-this-password\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "User profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/users/profile"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create genre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) pm.collectionVariables.set('genre_id', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Biography\"\n}" },
            "url": "{{base_url}}/genres"
          }
        },
        {
          "name": "List genres",
          "request": { "method": "GET", "url": "{{base_url}}/genres" }
        },
        {
          "name": "Get genre",
          "request": { "method": "GET", "url": "{{base_url}}/genres/{{genre_id}}" }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Biography and Memoir\"\n}" },
            "url": "{{base_url}}/genres/{{genre_id}}"
          }
        },
        {
          "name": "Delete genre",
          "request": { "method": "DELETE", "url": "{{base_url}}/genres/{{genre_id}}" }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create book (librarian)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) pm.collectionVariables.set('book_id', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A New Book\",\n  \"author\": \"Example Author\",\n  \"isbn\": \"9780306406157\",\n  \"totalCopies\": 3,\n  \"genreId\": \"{{genre_id}}\",\n  \"publishedYear\": 2024\n}"
            },
            "url": "{{base_url}}/books"
          }
        },
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/books?genreId={{genre_id}}&search=book&page=1&limit=10"
          }
        },
        {
          "name": "Get book",
          "request": { "method": "GET", "url": "{{base_url}}/books/{{book_id}}" }
        },
        {
          "name": "Update book (librarian)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 4\n}" },
            "url": "{{base_url}}/books/{{book_id}}"
          }
        },
        {
          "name": "Delete book (librarian)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/books/{{book_id}}"
          }
        }
      ]
    }
  ]
}
